# 蓝牙相关内核配置（追加到 ophub stable 配置模板之后）
# CM311-1a 的 RTL8761B 挂在 UART(serial0-0 / ttyAML0)，走 hci_uart(h5/serdev)，不是 btusb
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_LE=y
CONFIG_RFKILL=y
# 蓝牙遥控（BLE HID）经 uhid 注入输入子系统
CONFIG_UHID=m
CONFIG_INPUT_UINPUT=y
# 关掉 unifreq 树自带的 aic8800 厂商 wifi 驱动族：
# 6.18 起内核对 C23 严格原型默认 -Werror=strict-prototypes（CONFIG_WERROR 已关也照样报错），
# 该驱动的 aicwf_rx_prealloc.c 过不了这个检查，会中断整核编译；CM311-1a 用不到该芯片
# CONFIG_AIC8800_SUPPORT is not set
# CONFIG_AIC8800_SDIO_WLAN is not set
# CONFIG_AIC8800_USB_WLAN is not set
# CONFIG_AIC8800_BTUSB_SUPPORT is not set
